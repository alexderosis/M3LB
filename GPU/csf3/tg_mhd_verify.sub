#!/bin/bash --login
#==============================================================================
#  Taylor-Green MHD in a closed box (src/tg_mhd.cu): the DEVICE half of the
#  confined-MHD plan's Stage 2, and a throughput probe for Stage 3.
#
#  WHAT IS ALREADY ESTABLISHED WITHOUT A GPU (2026-09-25). The host build of
#  this driver reproduces the Kokkos parent, ../demonstrator/tg_mhd.cpp, to every
#  printed digit in FP64 -- runs A (free slip) and B (no slip), N = 65, Re = 200,
#  t = 0..2, 815 steps -- with no shared headers. The only non-zero column
#  differences are H_C and the skewness at t = 0, at 1e-17 of their scale, which
#  is round-off on quantities that vanish there. Both reference series are
#  tracked in results/P_tg_mhd/xcheck_n65_re200/. Since 2026-09-28 f_w is read
#  off the wall-distance profile (the series carry fw=profile) and each run also
#  writes profile.dat; the references were regenerated then -- every other
#  column unchanged to the printed digit -- and the device is checked on both;
#  since 2026-09-30 also on the profile's viscous and Ohmic parts
#  (profile_visc.dat, profile_ohm.dat), against references made the same way;
#  and since 2026-10-02 on the energy budget against wall distance (budget.dat),
#  whose host twins agree with each other to every printed digit after t = 0.
#  Since 2026-10-03 two more runs check Phase 2's options on the device -- a
#  smooth start (-ramp 0.2) and the box without a field at B's initial energy
#  (-vamp sqrt 2) -- against host references made the same way, because the
#  device half of the per-node wall velocity is code no host build compiles.
#
#  WHAT THIS JOB ADDS. The device build has never run: nvcc can reject what the
#  host compiler accepted (this tree has a list), and a device run can differ
#  from the host one in ways the host cannot see. So:
#
#    1. FP64 BUILD, and runs A and B at exactly the parameters above. The device
#       must match the tracked host series to the same printed digits -- or, if
#       it does not, the first differing column and time are the bug report.
#    2. FP32 BUILD and a short N = 257 pair (A and B, t = 1) for MLUPS and
#       memory, to size Stage 3's Re ladder (N = 192 .. 512).
#
#  BUILD NOTE: -DLBM_ONLY_OP=cm compiles one operator instead of four, which the
#  CSF3 notes measure at ~3 min against ~13. The driver uses Op::CentralMoments
#  only.
#
#  Submit from the repo root:   sbatch GPU/csf3/tg_mhd_verify.sub
#==============================================================================
#SBATCH -p gpuA
#SBATCH -G 1
#SBATCH -c 4
#SBATCH -t 0-2:00              # builds ~6 min, FP64 pair ~5 min, FP32 pair ~10 min
#SBATCH -J tg_mhd_verify
#SBATCH -o tg_mhd_verify-%j.log

set -euo pipefail

module purge
module load libs/cuda/12.8.1

ROOT=${M3LB_ROOT:-$SLURM_SUBMIT_DIR}
cd "$ROOT/GPU"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader
echo

# ---- 1. FP64: the twin check on the device ----------------------------------
cmake -S . -B build64 -DCMAKE_BUILD_TYPE=Release -DLBM_GPU_ARCH=80 \
      -DLBM_ONLY_OP=cm -DLBM_DOUBLE=ON > /dev/null
cmake --build build64 --target tg_mhd -j8
OUT="$ROOT/runs/tg_mhd_verify"      # runs/, like rb_cold: output is not source
mkdir -p "$OUT"
for W in slip noslip; do
  ./build64/tg_mhd -n 65 -vwall $W -mwall cond -ic tgc -re 200 -tmax 2 -probe 0.1 \
                   -out "$OUT/${W}_cuda_fp64" 2>&1 | tail -4
done
# Phase 2's two options (2026-10-03), whose device half -- Solver's per-node wall
# velocity -- no host build compiles: a smooth start, and the box without a field
# at B's initial energy.
./build64/tg_mhd -n 65 -vwall noslip -mwall cond -ic tgc -ramp 0.2 -re 200 -tmax 2 -probe 0.1 \
                 -out "$OUT/noslip_ramp0.2_cuda_fp64" 2>&1 | tail -4
./build64/tg_mhd -n 65 -vwall noslip -ic hydro -vamp 1.4142135623730951 -re 200 -tmax 2 -probe 0.1 \
                 -out "$OUT/hydro_va1.41421_cuda_fp64" 2>&1 | tail -4

python3 - "$ROOT" "$OUT" <<'EOF'
import sys
root, out = sys.argv[1], sys.argv[2]
names = ("t E_V E_M E_T H_C Omega_V Omega_M eps EM/EV OmM/OmV j_max w_max skew "
         "divb/j divb_wall/j mass_drift umax_lat fw1 fw2 fw4 tau_wall").split()
def load(p):
    return [[float(x) for x in l.split()] for l in open(p) if not l.startswith('#')]
bad = 0
for w in ("slip", "noslip", "noslip_ramp0.2", "hydro_va1.41421"):
    ref = load(f"{root}/results/P_tg_mhd/xcheck_n65_re200/{w}_src_kokkos_fp64.dat")
    dev = load(f"{out}/{w}_cuda_fp64/series.dat")
    if len(ref) != len(dev):
        print(f"{w}: {len(dev)} rows against {len(ref)} -- FAIL"); bad += 1; continue
    worst = []
    for i, n in enumerate(names):
        sc = max(max(abs(r[i]) for r in ref), 1e-300)
        d = max(abs(a[i] - b[i]) for a, b in zip(ref, dev))
        worst.append((d / sc, n))
    worst.sort(reverse=True)
    top = [(v, n) for v, n in worst if n not in ("H_C", "skew")]
    ok = top[0][0] < 1e-7
    bad += 0 if ok else 1
    print(f"{w}: device vs Kokkos parent, worst column {top[0][1]} {top[0][0]:.2e}"
          f" of its scale  {'PASS' if ok else 'FAIL'}")
    # profile.dat: each wall-distance layer's share of eps, which f_w is read
    # from. Shares are O(0.01-0.1) and printed to six figures, so 1e-6 absolute
    # is print rounding; the band-edge error it replaced was 1e-2.
    # ... and its viscous and Ohmic parts (profile_visc.dat, profile_ohm.dat, since
    # 2026-09-30), checked the same way.
    for part in ("", "_visc", "_ohm"):
        pref = load(f"{root}/results/P_tg_mhd/xcheck_n65_re200/{w}_src_kokkos_fp64_profile{part}.dat")
        pdev = load(f"{out}/{w}_cuda_fp64/profile{part}.dat")
        pw = (max(abs(x - y) for a, b in zip(pref, pdev) for x, y in zip(a[1:], b[1:]))
              if len(pref) == len(pdev) and pref else float("inf"))
        pok = pw < 1e-6
        bad += 0 if pok else 1
        print(f"{w}: device vs Kokkos parent, wall-distance profile{part or ''} worst |share| {pw:.2e}"
              f"  {'PASS' if pok else 'FAIL'}")
    # budget.dat (since 2026-10-02): the energy budget against wall distance, one row
    # per (probe, term). Each term is judged against its own largest value over the
    # run, because six of them vanish identically at t = 0 and print round-off there;
    # values are printed to seven figures, so 1e-6 of the scale is print rounding.
    def rows(p):
        out = {}
        for l in open(p):
            if not l.startswith('#'):
                q = l.split()
                out[(q[0], q[1])] = [float(x) for x in q[2:]]
        return out
    bref = rows(f"{root}/results/P_tg_mhd/xcheck_n65_re200/{w}_src_kokkos_fp64_budget.dat")
    bdev = rows(f"{out}/{w}_cuda_fp64/budget.dat")
    if bref.keys() != bdev.keys():
        print(f"{w}: budget.dat rows differ from the reference's -- FAIL"); bad += 1
    else:
        scale = {}
        for (t, term), v in bref.items():
            scale[term] = max(scale.get(term, 0.0), max(abs(x) for x in v))
        bw, bt = 0.0, ""
        for k, v in bref.items():
            d = max(abs(x - y) for x, y in zip(v, bdev[k])) / max(scale[k[1]], 1e-300)
            if d > bw:
                bw, bt = d, k[1]
        bok = bw < 1e-6
        bad += 0 if bok else 1
        print(f"{w}: device vs Kokkos parent, energy budget worst term {bt or '-'} {bw:.2e} of its scale"
              f"  {'PASS' if bok else 'FAIL'}")
sys.exit(1 if bad else 0)
EOF

# ---- 2. FP32: throughput at a Stage 3 size ----------------------------------
cmake -S . -B build32 -DCMAKE_BUILD_TYPE=Release -DLBM_GPU_ARCH=80 \
      -DLBM_ONLY_OP=cm > /dev/null
cmake --build build32 --target tg_mhd -j8
for W in slip noslip; do
  ./build32/tg_mhd -n 257 -vwall $W -mwall cond -ic tgc -re 500 -tmax 1 -probe 0.25 \
                   -out "$OUT/${W}_cuda_fp32_n257" 2>&1 | tail -5
done
