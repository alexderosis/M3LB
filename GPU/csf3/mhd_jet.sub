#!/bin/bash --login
#==============================================================================
#  Transitional MHD jet -- the Williams, De Rosis & Skillen (JFM) case, run with
#  the lattice Boltzmann solver instead of their sixth-order FD DNS.
#
#  Defaults to nx = 512 in FP32.  Both of those are choices with costs; set
#  NX and PREC below, or in the environment, to change them.
#
#  WHAT THIS IS FOR.  Their argument rests on two curves: gamma(t), the magnetic
#  energy growth rate (their Fig. 2 left), and the per-component current maxima
#  (Fig. 2 right), whose crossing at t ~ 82 is how they date the 3D onset.  Both
#  are domain integrals, so both survive being computed on a coarser grid by a
#  different discretisation -- which is what makes them worth comparing.  The
#  driver prints them as columns.  Nothing else here is meant to be compared:
#  see the banner in GPU/src/mhd_jet.cu for the three places this run cannot be
#  their run, and for why spectra and stress PDFs are deliberately absent.
#
#  READ TWO NUMBERS BEFORE ANY OTHERS.
#
#  (1) `initial max|div u|/k|u|`, on the startup line.  The initial condition is
#      solenoidal by construction, so this IS the round-off noise floor in the
#      velocity field.  FP64 gives 7.0e-15; FP32 gives 3.3e-6, which is a factor
#      of three below the 1e-5 seed rather than nine decades below it.  In FP32
#      the noise competes with the seed for the whole 2.8e5 steps, so THE ONSET
#      TIME FROM AN FP32 RUN SHOULD NOT BE QUOTED AGAINST THEIR t = 82.  The
#      shape of gamma(t), the jz-then-jx,jy ordering and the energy partition do
#      not depend on when the seed took hold and stay readable.  This is a known
#      and accepted cost of the default, not a discovered fault.
#
#  (2) max|divB|, on every row.  Not cleaned here; they hold it below 1e-13.  A
#      div B error is a monopole and monopoles reconnect, so on THIS case the
#      scheme can tell the right story for the wrong reason.  It reached 5.24 on
#      Orszag-Tang at Re = 3040.
#
#  COST, from the one measurement there is: 978.5 MLUPS FP64 on a gpuA A100 at
#  23.9 M nodes (the Re = 3040 Orszag-Tang run).  There is NO measured A100
#  FP32:FP64 ratio for this code -- the only FP32 number in the tree is 309.6
#  MLUPS on a T4, a different card -- so the FP32 estimate is a bracket:
#
#      nx    prec    cells     GB    stepping     probes     total    tau-1/2
#      256   fp32    24.0 M    4.0    0.5-0.6 h    ~0.3 h    ~0.9 h   3.1e-4
#      256   fp64    24.0 M    7.9    1.0 h        ~0.3 h    ~1.3 h   3.1e-4
#      512   fp32   192.4 M   31.7    7.7-10.2 h   ~2.5 h    ~12 h    6.2e-4
#      512   fp64   192.4 M   63.3   15.3 h        ~2.5 h    ~18 h    6.2e-4
#
#  D3Q27+D3Q7 is strongly bandwidth bound, so FP32 should approach the 2x end;
#  the CSF3 README records one regime where this code went ALU-bound on a T4,
#  and an A100's 1:2 FP64:FP32 ratio leaves less to recover than a consumer
#  card's 1:32.  Plan on the slow end.  The 31.7 GB of FP32 at nx = 512 also
#  fits a 40 GB A100, where 63.3 GB does not, which may matter for queueing.
#
#  THE THING MOST LIKELY TO GO WRONG.  tau - 1/2 = 6.2e-4 at nx = 512.  Every
#  MHD run this scheme is established on sat at 2.0e-3.  The driver prints a
#  NOTE saying so and prints DIVERGED with the time if it goes.  If it does:
#      -ma 0.06  -> tau - 1/2 = 1.1e-3, and 159k steps instead of 280k
#      -ma 0.10  -> tau - 1/2 = 1.8e-3, 95k steps, but 1 % compressibility
#  Raising resolution moves tau AWAY from the floor and coarsening moves it
#  toward -- the opposite of the usual instinct, and why nx = 256 is the cheaper
#  run but not the safer one.
#
#  WHAT COMES OUT, under $SLURM_SUBMIT_DIR/mhd_jet_<nx>_<prec>/:
#      log.txt                     the columns, including gamma and jx/jy/jz
#      anim_frames/umag,bmag,jmag  x1-x2 mid-plane slices, nx x ny float32
#      anim_frames/jvol_*.raw      the |J| volume, block-MAX reduced
#      anim_frames/meta.txt        N, nx, ny, dt, R 0, Te, and the volume extents
#
#  WHY THE VOLUME IS WORTH ITS SIZE.  A current sheet is one or two cells thick,
#  so a flat mid-plane cut through one mostly misses it and the slice movie
#  understates exactly the structure this case is about.  At 512 x 734 x 512 a
#  full |J| frame is 770 MB, which is not a movie; -volstride 4 reduces it by
#  BLOCK MAXIMUM to 128 x 184 x 128 = 12.1 MB, and 150 of those is 1.8 GB.
#  Maximum, not mean: a mean averages a one-cell sheet against quiet neighbours
#  and dims the thing being filmed.  Verified bit-identical to the
#  full-resolution peak at stride 1 -- the reduction loses no maximum.
#  The stride need not divide any extent; 734 is not a multiple of 4 and the
#  last block on each axis is simply short.
#
#  IT IS NOT FREE.  The reduction visits every one of the 192 M cells once per
#  volume frame, single-threaded on the host, which is order 10 s a frame here
#  -- about 25 min across the run, on top of the probe cost already counted.
#  The slices are their Fig. 1 middle row.  results/N_mhd_sphere/render_slices.py
#  reads the .raw headers so it gets the dimensions right, but it was written
#  for a SQUARE slice and this one is not -- expect to adjust its layout before
#  the pictures are usable.  log.txt needs nothing.
#==============================================================================
#SBATCH -p gpuA
#SBATCH -G 1
#SBATCH -c 4
#SBATCH -t 1-00:00             # ~12 h expected at the default; the rest is
                               # margin for the slow end of the FP32 bracket
#SBATCH -J mhd_jet
#SBATCH -o mhd_jet-%j.log

set -euo pipefail

module purge
module load libs/cuda/12.8.1

NX=${NX:-512}
PREC=${PREC:-fp32}
case "$PREC" in
  fp32) DBL=OFF ;;
  fp64) DBL=ON  ;;
  *) echo "ERROR: PREC must be fp32 or fp64, not '$PREC'" >&2; exit 1 ;;
esac

# Separate build trees per precision: Real is a compile-time typedef, so one
# tree cannot hold both and a stale binary would run at the OTHER precision
# without saying so anywhere except its own header line.
ROOT=${M3LB_ROOT:-$SLURM_SUBMIT_DIR}
BIN="$ROOT/GPU/build_$PREC/mhd_jet"
if [ ! -x "$BIN" ]; then
  echo "ERROR: no executable at $BIN" >&2
  echo "  This is GPU/, not the Kokkos tree. Build it with:" >&2
  echo "    cd $ROOT/GPU && cmake -S . -B build_$PREC -DCMAKE_BUILD_TYPE=Release \\" >&2
  echo "        -DLBM_GPU_ARCH=80 -DLBM_DOUBLE=$DBL -DLBM_ONLY_OP=cm" >&2
  echo "    cmake --build build_$PREC --target mhd_jet -j8" >&2
  exit 1
fi

OUT="$ROOT/mhd_jet_${NX}_${PREC}"
mkdir -p "$OUT"
cd "$OUT"

nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader
echo

# -probes 300 is one sample per dt = 0.5 of their time, which is what resolves
# gamma(t) through the SGTR growth phase they put at 82 <= t <= 88 -- eight
# points across it, and fewer would not show its shape.  It is not free: each
# sample pulls six fields to the host (4.6 GB at nx = 512 in FP32) and walks
# every node single-threaded, so it is roughly 2.5 h of the total.  That is the
# price of the one curve this run exists to produce, so it is paid.
# -dump 2 puts a slice frame on every other sample: 150 frames, ~675 MB.
# -dumpvol 1 puts a |J| volume on every one of those, -volstride 4 reducing it
# to 128 x 184 x 128: 150 frames, ~1.8 GB.  Raise the stride, or drop -dumpvol
# to 2, if that is more than the scratch quota wants to hold.
"$BIN" -nx "$NX" -re 3500 -pm 1 -s 52.5 -ma 0.034 -tmax 150 \
       -probes 300 -dump 2 -dumpvol 1 -volstride 4 -op cm 2>&1 | tee log.txt

echo
echo "slices : $(ls anim_frames/jmag_*.raw 2>/dev/null | wc -l)"
echo "volumes: $(ls anim_frames/jvol_*.raw 2>/dev/null | wc -l)"
du -sh anim_frames 2>/dev/null || true
